            end
        end
    end
end)

-- afk boss server hop:
-- hops 3 seconds after being enabled / after joining a server, and only hops
-- again when the selected boss is dead or gone
task.spawn(function()
    local ready = false
    repeat task.wait(0.5) until not alive() or (LP.Character and getRoot())
    ready = true
    local absentSince = nil
    while alive() do
        task.wait(0.5)
        if Config.JoinAFK and ready then
            local name = Config.SelectBoss
            if findBoss(name) then
                absentSince = nil
                if not Config.FarmBoss then setStatus(name .. " is alive in this server") end
            else
                absentSince = absentSince or tick()
                local left = 3 - (tick() - absentSince)
                if hopMsg and tick() - hopMsgAt < 8 then
                    setStatus(hopMsg)
                elseif left > 0 then
                    setStatus(("%s not found, hopping in %.0fs"):format(name, math.ceil(left)))
                else
                    absentSince = nil
                    local info = Bosses[name]
                    hop(info.key, info.place, function(t)
                        hopMsg, hopMsgAt = t, tick()
                        setStatus(t)
                    end)
                end
            end
        else
            absentSince = nil
        end
    end
end)

