local farmTarget = nil

-- movement (fly at 175) + noclip
RunService.Heartbeat:Connect(function(dt)
    if not alive() then return end
    local root = getRoot()
    if not root or not farmTarget then return end
    local tr = farmTarget:FindFirstChild("HumanoidRootPart")
    if not tr then return end
    local goal = tr.Position + Vector3.new(0, 18, 0)
    local d = goal - root.Position
    local step = SPEED * dt
    local newPos = (d.Magnitude <= step) and goal or (root.Position + d.Unit * step)
    local rot = root.CFrame - root.CFrame.Position
    root.CFrame = CFrame.new(newPos) * rot
    root.AssemblyLinearVelocity = Vector3.zero
end)

RunService.Stepped:Connect(function()
    if not alive() or not farmTarget then return end
    local c = LP.Character
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
end)

local function equipWeapon()
    local c, hum = LP.Character, getHum()
    if not c or not hum then return end
    -- already holding the melee? nothing to do
    local held = c:FindFirstChildOfClass("Tool")
    if held and held.ToolTip == "Melee" then return end
    -- otherwise find the melee in the backpack and equip it
    for _, t in ipairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and t.ToolTip == "Melee" then
            hum:EquipTool(t)
            return
        end
    end
end

local function enableHaki()
    local c = LP.Character
    if not c or c:FindFirstChild("HasBuso") then return end
    pcall(function() RS.Remotes.CommF_:InvokeServer("Buso") end)
end

local Net = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Net")
local RegAttack = Net and Net:FindFirstChild("RE/RegisterAttack")
local RegHit    = Net and Net:FindFirstChild("RE/RegisterHit")

local function attack(enemy)
    local c = LP.Character
    local tool = c and c:FindFirstChildOfClass("Tool")
    if not tool then return end
    if Config.FastAttack and RegAttack and RegHit then
        local part = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
        pcall(function()
            RegAttack:FireServer(0)
            RegHit:FireServer(part, { { enemy, part } })
        end)
    end
    -- normal click as well (works with fruit M1, melee and sword)
    pcall(function()
        VU:CaptureController()
        VU:Button1Down(Vector2.new(1280, 672))
        VU:Button1Up(Vector2.new(1280, 672))
    end)
    pcall(function() tool:Activate() end)
end

