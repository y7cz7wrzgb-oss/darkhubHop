local function applyTeam()
    local remotes = RS:WaitForChild("Remotes", 15)
    local commF = remotes and remotes:WaitForChild("CommF_", 15)
    if not commF then return end
    local t0 = tick()
    while alive() and not LP.Team and tick() - t0 < 30 do
        pcall(function()
            commF:InvokeServer("SetTeam", Config.Team == "Pirate" and "Pirates" or "Marines")
        end)
        task.wait(1)
    end
end

------------------------------------------------------------------
-- Server hop (Quantum Onyx API)
------------------------------------------------------------------
local GUID = "%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x"

local HEADERS = {
    ["User-Agent"] = "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36",
    ["Accept"] = "application/json, text/plain, */*",
}

-- returns body, debugText
local function httpGet(url)
    local dbg = "no http function"
    local req = (syn and syn.request) or request or http_request or (http and http.request)
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET", Headers = HEADERS })
        if ok and res then
            local body = res.Body or ""
            dbg = ("HTTP %s, %d bytes: %s"):format(tostring(res.StatusCode), #body, body:sub(1, 60):gsub("%s+", " "))
            if body ~= "" and (res.StatusCode == nil or res.StatusCode == 200) then return body, dbg end
        else
            dbg = "request error: " .. tostring(res):sub(1, 60)
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and body and body ~= "" then
        return body, ("HttpGet, %d bytes: %s"):format(#body, body:sub(1, 60):gsub("%s+", " "))
    end
    return nil, dbg .. " | HttpGet failed"
end

-- returns entries {job, place, players, max, ts}, debugText
-- API format: {"<key>":[{"timestamp":"...","placeId":"...","jobId":"...","players":"8/12"}, ...]}
local function fetchJobs(key)
    local body, dbg = httpGet(API .. key)
    local entries = {}
    if not body then return entries, dbg end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or type(data) ~= "table" then
        return entries, "invalid JSON | " .. tostring(dbg)
    end
    local list = data[key]
    if type(list) ~= "table" then
        for _, v in pairs(data) do
            if type(v) == "table" then list = v break end
        end
    end
    if type(list) ~= "table" then return entries, "empty list | " .. tostring(dbg) end
    local byJob = {}
    for _, e in ipairs(list) do
        if type(e) == "table" and type(e.jobId) == "string" and e.jobId ~= "" then
            local cur, max = tostring(e.players or ""):match("(%d+)%s*/%s*(%d+)")
            local entry = {
                job = e.jobId,
                place = tonumber(e.placeId),
                players = tonumber(cur) or 0,
                max = tonumber(max) or 12,
                ts = tostring(e.timestamp or ""),
            }
            -- keep only the newest log of each server
            if not byJob[e.jobId] or entry.ts > byJob[e.jobId].ts then
                byJob[e.jobId] = entry
            end
        end
    end
    for _, e in pairs(byJob) do table.insert(entries, e) end
    table.sort(entries, function(x, y) return x.ts > y.ts end) -- newest first
    return entries, dbg
end

local function queueScript()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport)
    if q and isfile and isfile(SCRIPT_FILE) then
        pcall(q, 'loadstring(readfile("' .. SCRIPT_FILE .. '"))()')
    end
end

local hopping = false
local hopQueue, hopQueueKey, hopQueueAt = {}, nil, 0
local lastHop = nil
local TRIED_TTL = 120 -- seconds a failed/used server is skipped

local hop

local function buildQueue(key, onStatus)
    local entries, dbg = fetchJobs(key)
    local open, full = {}, {}
    for _, e in ipairs(entries) do
        local t = Config.Tried[e.job]
        if e.job ~= game.JobId and not (t and os.time() - t < TRIED_TTL) then
            if e.players < e.max then
                table.insert(open, e)   -- not full (newest first)
            else
                table.insert(full, e)   -- logged as full; Roblox rejects it instantly if still full
            end
        end
    end
    for _, e in ipairs(full) do table.insert(open, e) end
    hopQueue, hopQueueKey, hopQueueAt = open, key, tick()
    if #open == 0 and onStatus then
        if #entries == 0 then
            onStatus("No server for '" .. key .. "' | " .. tostring(dbg))
        else
            onStatus(("Found %d server(s) for '%s' but all were already tried"):format(#entries, key))
        end
    end
end

-- A teleport that fails (server full, etc.) instantly tries the next server
TS.TeleportInitFailed:Connect(function(_, result, msg)
    if not alive() then return end
    hopping = false
    if lastHop then
        local h = lastHop
        if h.onStatus then h.onStatus("Server unavailable (" .. tostring(result) .. "), trying next...") end
        task.defer(function() hop(h.key, h.placeId, h.onStatus) end)
    end
end)

hop = function(key, placeId, onStatus)
    if hopping then return false end
    hopping = true
    lastHop = { key = key, placeId = placeId, onStatus = onStatus }

    if hopQueueKey ~= key or #hopQueue == 0 or tick() - hopQueueAt > 30 then
        buildQueue(key, onStatus)
    end
    if #hopQueue == 0 then
        lastHop = nil
        task.delay(2, function() hopping = false end)
        return false
    end

    local e = table.remove(hopQueue, 1)
    Config.Tried[e.job] = os.time()
    saveConfig()
    queueScript()
    if onStatus then onStatus(("Joining '%s' server (%d/%d)..."):format(key, e.players, e.max)) end
    local ok, err = pcall(function()
        TS:TeleportToPlaceInstance(e.place or placeId or game.PlaceId, e.job, LP)
    end)
    if not ok then
        -- invalid id / immediate error: try the next one right away
        hopping = false
        return hop(key, placeId, onStatus)
    end
    -- safety: if nothing happens in 20s, allow another attempt
    task.delay(20, function() hopping = false end)
    return true
end

