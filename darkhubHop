-- attack loop
task.spawn(function()
    while alive() do
        task.wait(Config.FastAttack and 0.1 or 0.35)
        local t = farmTarget
        if t and t.Parent then
            local hum = t:FindFirstChildOfClass("Humanoid")
            local root = getRoot()
